# ─────────────────────────────────────────────────────────────
# Nestora · Backoffice (portail de management)
# Copie ce fichier en .env.local puis remplis les valeurs.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API (même projet que le storefront)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : serveur uniquement, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001
STOREFRONT_URL=http://localhost:3000

# ── Double authentification (code à 6 chiffres envoyé par email) ──
# Secret aléatoire d'au moins 32 caractères (ex. : openssl rand -hex 32).
ADMIN_2FA_SECRET=
ADMIN_2FA_CODE_TTL_SECONDS=300
ADMIN_2FA_MAX_ATTEMPTS=5
ADMIN_2FA_RESEND_SECONDS=30

# Déconnexion automatique après inactivité (minutes).
# Garder la même valeur que public.staff_idle_minutes() dans la migration.
NEXT_PUBLIC_ADMIN_IDLE_MINUTES=20

# ── SMTP utilisé pour envoyer le code de vérification ────────
# En développement, si SMTP_HOST est vide, le code est affiché dans la console du serveur.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true pour le port 465 (SSL), false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=zguebmed.sadok@gmail.com
SMTP_PASS=imsf ddnw crgy vcrg
SMTP_SENDER_EMAIL=zguebmed.sadok@gmail.com
SMTP_SENDER_NAME=Nestora Ops
